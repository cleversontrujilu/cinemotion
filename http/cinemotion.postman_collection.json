        {
          "name": "Cria uma Sala 5×8 (A1–E8): A1 e A2 acessíveis, E8 em manutenção",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "if (pm.response.code < 300) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('theaterId', json.id);",
                  "  pm.collectionVariables.set('seatA3', json.seats[2].id);",
                  "  pm.collectionVariables.set('seatA4', json.seats[3].id);",
                  "  pm.collectionVariables.set('seatA5', json.seats[4].id);",
                  "  pm.collectionVariables.set('seatA6', json.seats[5].id);",
                  "  pm.collectionVariables.set('seatB1', json.seats[8].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{adminUrl}}/theaters",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sala HTTP {{$timestamp}}\",\n  \"rows\": 5,\n  \"seatsPerRow\": 8,\n  \"accessibleSeats\": [\"A1\", \"A2\"],\n  \"maintenanceSeats\": [\"E8\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
