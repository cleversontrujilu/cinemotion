{
  "name": "@cinemotion/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API REST do Cinemotion: um código, dois handlers Lambda (customer e admin)",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "db:migrate": "node-pg-migrate up -m migrations -j sql --envPath .env -d MIGRATION_DATABASE_URL",
    "db:migrate:down": "node-pg-migrate down -m migrations -j sql --envPath .env -d MIGRATION_DATABASE_URL",
    "db:seed": "sh -c \"set -a; [ -f .env ] && . ./.env; set +a; psql \\\"\\$MIGRATION_DATABASE_URL\\\" -v ON_ERROR_STOP=1 -f seeds/seed.sql\"",
    "db:reset": "./scripts/db-reset.sh",
    "build:lambda": "node scripts/build-lambda.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "serverless-http": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "node-pg-migrate": "^9.0.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
