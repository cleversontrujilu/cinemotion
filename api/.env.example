# Copie para .env e ajuste. O .env nunca é versionado.

# Dono do schema: usado só por migrations, seed e reset (máquina local).
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/cinemotion

# Roles da aplicação (criados pela migration 0001). Na AWS cada Lambda recebe só DATABASE_URL.
# O db:reset define estas senhas apenas no banco local.
CUSTOMER_DATABASE_URL=postgres://cinemotion_customer:cinemotion_customer@localhost:5432/cinemotion
ADMIN_DATABASE_URL=postgres://cinemotion_admin:cinemotion_admin@localhost:5432/cinemotion

# Conexões por instância. Na Lambda fica em 1.
DB_POOL_MAX=1

# Servidor local (npm run dev)
CUSTOMER_PORT=3000
ADMIN_PORT=3001
