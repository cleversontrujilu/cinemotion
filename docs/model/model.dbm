<index name="ux_theater_name" table="public.theater"
	 concurrent="false" unique="true" fast-update="false" buffering="false" nulls-not-distinct="false"
	 index-type="btree" factor="0">
		<idxelement use-sorting="false">
			<column name="name"/>
		</idxelement>
</index>

<index name="ux_seat_row_number" table="public.seat"
	 concurrent="false" unique="true" fast-update="false" buffering="false" nulls-not-distinct="false"
	 index-type="btree" factor="0">
		<idxelement use-sorting="false">
			<column name="theater_id"/>
		</idxelement>
		<idxelement use-sorting="false">
			<column name="seat_row"/>
		</idxelement>
		<idxelement use-sorting="false">
			<column name="number"/>
		</idxelement>
</index>

<relationship name="user_has_many_reservation" type="rel1n" layers="0"
	 src-col-pattern="{st}_{sc}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 fk-idx-pattern="{st}_idx"
	 custom-color="#e87d22"
	 src-table="public.app_user"
	 dst-table="public.reservation"
	 src-required="true" dst-required="false">
	<label ref-type="name-label">
		<position x="0" y="0"/>
	</label>
</relationship>

<index name="ux_app_user_email" table="public.app_user"
	 concurrent="false" unique="true" fast-update="false" buffering="false" nulls-not-distinct="false"
	 index-type="btree" factor="0">
		<idxelement use-sorting="false">
			<expression> <![CDATA[lower(email)]]> </expression>
		</idxelement>
</index>

<constraint name="uq_reservation_id_session_id" type="uq-constr" table="public.reservation">
	<columns names="id,session_id" ref-type="src-columns"/>
</constraint>

<index name="ux_reservation_seat_session_id_seat_id" table="public.reservation_seat"
	 concurrent="false" unique="true" fast-update="false" buffering="false" nulls-not-distinct="false"
	 index-type="btree" factor="0">
		<idxelement use-sorting="false">
			<column name="session_id"/>
		</idxelement>
		<idxelement use-sorting="false">
			<column name="seat_id"/>
		</idxelement>
	<predicate> <![CDATA[released_at IS NULL]]> </predicate>
</index>

<constraint name="reservation_id_session_id_fk" type="fk-constr" comparison-type="MATCH SIMPLE"
	 upd-action="NO ACTION" del-action="CASCADE" ref-table="public.reservation" table="public.reservation_seat">
	<columns names="reservation_id,session_id" ref-type="src-columns"/>
	<columns names="id,session_id" ref-type="dst-columns"/>
</constraint>

<relationship name="rel_reservation_seat_reservation" type="relfk" layers="0"
	 src-table="public.reservation_seat"
	 dst-table="public.reservation" reference-fk="reservation_id_session_id_fk"
	 src-required="false" dst-required="true"/>

</dbmodel>
