	 show-layer-names="false" show-layer-rects="false">
<database name="cinemotion" is-template="false" allow-conns="true">
</database>

<schema name="public" layers="0" fill-color="#e1e1e1" name-color="#000000" sql-disabled="true">
</schema>

<table name="public.movie" layers="0" collapse-mode="2" max-obj-count="3" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="140" y="280"/>
	<column name="id" not-null="true" default-value="uuidv7()">
		<type name="uuid" length="36"/>
	</column>
	<column name="title" not-null="true">
		<type name="varchar" length="200"/>
	</column>
	<column name="duration" not-null="true">
		<type name="int4" length="0"/>
		<comment> <![CDATA[Duration in minutes]]> </comment>
	</column>
	<constraint name="movie_pk" type="pk-constr" table="public.movie">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
</table>

<table name="public.theater" layers="0" collapse-mode="2" max-obj-count="2" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="600" y="300"/>
	<column name="id" not-null="true" default-value="uuidv7()">
		<type name="uuid" length="0"/>
	</column>
	<column name="name" not-null="true">
		<type name="varchar" length="55"/>
	</column>
	<constraint name="theater_pk" type="pk-constr" table="public.theater">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
</table>

<table name="seat" layers="0" collapse-mode="2" max-obj-count="6" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="1040" y="280"/>
	<column name="id" not-null="true" default-value="uuidv7()">
		<type name="uuid" length="0"/>
	</column>
	<column name="seat_row" not-null="true">
		<type name="varchar" length="3"/>
		<comment> <![CDATA[Ex.: the seat is in row J or AA]]> </comment>
	</column>
	<column name="number" not-null="true">
		<type name="int2" length="0"/>
		<comment> <![CDATA[1 - 99]]> </comment>
	</column>
	<column name="is_available" not-null="true" default-value="true">
		<type name="boolean" length="0"/>
	</column>
	<constraint name="seat_pk" type="pk-constr" table="public.seat">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_seat_number" type="ck-constr" table="public.seat">
			<expression> <![CDATA[number BETWEEN 1 AND 99]]> </expression>
	</constraint>

	<customidxs object-type="column">
		<object name="theater_id" index="4"/>
	</customidxs>
	<customidxs object-type="constraint">
		<object name="theater_fk" index="1"/>
	</customidxs></table>

<table name="public.session" layers="0" collapse-mode="2" max-obj-count="7" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<appended-sql> <![CDATA[CREATE EXTENSION IF NOT EXISTS btree_gist;

ALTER TABLE session    
  ADD CONSTRAINT session_time_chk CHECK (ends_at > starts_at),
  ADD CONSTRAINT session_no_overlap EXCLUDE USING gist (
      theater_id WITH =,
      tstzrange(starts_at, ends_at, '[)') WITH &&
  );]]> </appended-sql>
	<position x="320" y="500"/>
	<column name="id" not-null="true" default-value="uuidv7()">
		<type name="uuid" length="0"/>
	</column>
	<column name="starts_at" not-null="true">
		<type name="timestamptz" length="0"/>
	</column>
	<column name="price" not-null="true">
		<type name="numeric" length="10" precision="2"/>
	</column>
	<column name="ends_at" not-null="true">
		<type name="timestamptz" length="0"/>
	</column>
	<constraint name="session_pk" type="pk-constr" table="public.session">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="ix_price" type="ck-constr" table="public.session">
			<expression> <![CDATA[price >= 0]]> </expression>
	</constraint>

	<customidxs object-type="column">
		<object name="movie_id" index="1"/>
		<object name="theater_id" index="2"/>
	</customidxs>
	<customidxs object-type="constraint">
		<object name="movie_fk" index="1"/>
		<object name="theater_fk" index="2"/>
	</customidxs></table>

