<table name="public.reservation" layers="0" collapse-mode="2" max-obj-count="9" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="820" y="560"/>
	<column name="id" not-null="true" default-value="uuidv7()">
