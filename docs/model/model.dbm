<usertype name="user_role" configuration="enumeration">
	<schema name="public"/>
	<role name="postgres"/>
	<enumeration label="admin"/>
	<enumeration label="customer"/>
</usertype>

<usertype name="reservation_status" configuration="enumeration">
	<schema name="public"/>
	<role name="postgres"/>
	<enumeration label="pending"/>
	<enumeration label="confirmed"/>
	<enumeration label="cancelled"/>
	<enumeration label="expired"/>
</usertype>

